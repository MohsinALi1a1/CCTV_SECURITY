# Copy this file to ".env" and change the values. Never share or commit .env.

# Your time zone (list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Asia/Karachi

# MQTT login used by Frigate, the event engine and MQTT Explorer
MQTT_USER=smarttech
MQTT_PASSWORD=change-me-mqtt

# Mobile app (Firebase). Put the service account key in secrets/firebase-service-account.json
FIREBASE_ENABLED=true
# One id per house; the app subscribes to push topic smarttech_<HOME_ID>
HOME_ID=home_01
HOME_NAME=My Home

# IP camera login (not used by the PC webcam, needed for real cameras later)
RTSP_USER=admin
RTSP_PASSWORD=change-me-camera

# Network scanned by 'Add camera > Scan' (your router's network)
LAN_SUBNET=192.168.1.0/24
